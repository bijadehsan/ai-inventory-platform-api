# Store all text files with LF line endings in the repository
* text=auto eol=lf

# Windows-only scripts keep CRLF (Windows tools expect it)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
